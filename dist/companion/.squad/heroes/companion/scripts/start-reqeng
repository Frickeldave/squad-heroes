#!/usr/bin/env node
import { composeFlowPrompt, launchCopilot, requireSquad2, loadConfig, resolveModel, verifyAuth } from './heroes-flow-shared';
import { resolvePrompt } from './resolve-heroes-prompt';
const argv = process.argv.slice(2);
if (argv.includes('--help') || argv.includes('-h')) {
  console.log('Usage: start-reqeng.mjs [--issue N] [--model ID] [--prompt TEXT] [--noprompt|--plan] [--notmux]');
  process.exit(0);
}
requireSquad2();
const config = loadConfig();
verifyAuth(config.repository);
const model = await resolveModel('reqeng', argv);
const prompt = composeFlowPrompt('reqeng', resolvePrompt('reqeng', config.language), argv, config);
console.log(JSON.stringify({ flow: 'reqeng', model, prompt }));
launchCopilot(model, prompt, argv);
